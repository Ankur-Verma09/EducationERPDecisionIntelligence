EDUERP_ENVIRONMENT=local
EDUERP_LOG_LEVEL=INFO
# Runtime credentials must be a non-owner, NOSUPERUSER, NOBYPASSRLS role.
EDUERP_DATABASE_URL=postgresql+psycopg://education_erp_app:change-me@localhost:5432/education_erp
EDUERP_DATABASE_CONNECT_TIMEOUT_SECONDS=3
# Supply a random secret of at least 24 characters outside local/test environments.
EDUERP_CURSOR_SIGNING_KEY=local-cursor-signing-key-change-me
EDUERP_DOCS_ENABLED=true
EDUERP_DEMO_CONNECTOR_ENABLED=true
EDUERP_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
EDUERP_OIDC_ISSUER_URL=
EDUERP_OIDC_AUDIENCE=
EDUERP_OIDC_ALGORITHMS=RS256
EDUERP_OIDC_JWKS_CACHE_SECONDS=300
EDUERP_OIDC_CLOCK_SKEW_SECONDS=60
EDUERP_PRIVILEGED_MFA_METHODS=mfa,otp,webauthn

# Future self-hosted AI deployment contract. Core does not read these values.
# The Work Package 1 test double performs no inference and needs no credentials.
AI_EXTERNAL_PROVIDER_ACCESS=disabled
AI_INFERENCE_ENABLED=false
AI_INFERENCE_BASE_URL=http://ai-contract-test-double:8080
AI_MAX_INPUT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=512
AI_MAX_CONCURRENCY=2
AI_QUEUE_LIMIT=8
AI_REQUEST_TIMEOUT_SECONDS=15
